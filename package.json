{
  "name": "dsh-session-enhance",
  "version": "5.2.0",
  "description": "会话增强：按 ID 查看任意会话与它的全部子代理，标题栏复制会话 ID，免登录只读分享链接，用户中断的一轮可重试（补官方「继续生成」不覆盖的中断场景），以及类似 Claude Code 的分级上下文压缩（自动/手动，设置页可开关）。三个可单独启停的组件。",
  "type": "module",
  "license": "MIT",
  "private": true,
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./share": "./share/index.js",
    "./retry": "./retry/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./share/locale/*.json": "./share/locale/*.json",
    "./retry/locale/*.json": "./retry/locale/*.json",
    "./share/icon": "./icon.svg",
    "./retry/icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "share/**",
    "retry/**",
    "lib/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "test/**"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "session",
    "session-inspect",
    "session-id",
    "subagent",
    "clipboard",
    "share",
    "retry",
    "turn",
    "interrupt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lldwb/dsh-session-enhance.git"
  },
  "homepage": "https://github.com/lldwb/dsh-session-enhance#readme",
  "bugs": {
    "url": "https://github.com/lldwb/dsh-session-enhance/issues"
  },
  "meta": {
    "title": "会话增强",
    "description": "三个独立组件：按 ID 查看任意会话与它的全部子代理（含标题栏复制会话 ID）并带分级上下文压缩（自动/手动，设置页可开关）；把会话分享成免登录只读链接；用户点了停止的一轮可以在 composer 上重试（官方「继续生成」只覆盖模型失败）。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
